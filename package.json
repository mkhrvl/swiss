{
  "name": "swiss",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "assets": "node scripts/prepare-web-assets.mjs && node scripts/prepare-identity-assets.mjs",
    "dev": "pnpm assets && pnpm --filter @swiss/pwa dev",
    "dev:extension": "pnpm assets && pnpm --filter @swiss/extension dev",
    "dev:firefox": "pnpm assets && pnpm --filter @swiss/extension dev:firefox",
    "build": "pnpm assets && pnpm --filter @swiss/pwa build && pnpm --filter @swiss/extension build && pnpm --filter @swiss/extension build:firefox",
    "check": "pnpm -r check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "format": "prettier --write apps packages scripts/*.mjs *.mjs *.json *.yaml vitest.config.ts",
    "format:check": "prettier --check apps packages scripts/*.mjs *.mjs *.json *.yaml vitest.config.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm verify:identity && pnpm build",
    "verify:identity": "dotnet tool restore && dotnet csharpier check packages/core/src/identity-passwords/dotnet && dotnet test --project packages/core/src/identity-passwords/dotnet/Swiss.Identity.Tests/Swiss.Identity.Tests.csproj -c Release -p:TreatWarningsAsErrors=true",
    "test:browser": "node apps/pwa/tests/browser/smoke.mjs && node apps/extension/tests/browser/chromium.mjs",
    "test:dev": "pnpm assets && node apps/pwa/tests/browser/dev.mjs",
    "test:dev:firefox": "pnpm assets && node apps/extension/tests/browser/dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "shadcn": "4.21.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
